generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATED
}

model Quiz {
  id          String         @id @default(uuid())
  userId      String
  documentId  String?
  topicId     String?
  title       String
  language    String         @default("en")
  difficulty  String         @default("MEDIUM")
  createdAt   DateTime       @default(now())
  questions   QuizQuestion[]

  @@map("quizzes")
}

model QuizQuestion {
  id            String   @id @default(uuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type          String   // 'MCQ' | 'SHORT_ANSWER' | 'STRUCTURED'
  prompt        String
  options       Json?    // Array of options
  correctAnswer String
  explanation   String
  difficulty    String
  topicId       String
  sourcePages   Json?    // Array of page numbers
  marks         Float    @default(1.0)
  createdAt     DateTime @default(now())

  @@map("quiz_questions")
}

model Exam {
  id              String         @id @default(uuid())
  title           String
  description     String?
  subjectId       String
  durationMinutes Int            @default(60)
  passPercentage  Float          @default(40.0)
  totalMarks      Float          @default(100.0)
  language        String         @default("en")
  isPublished     Boolean        @default(true)
  createdAt       DateTime       @default(now())
  questions       ExamQuestion[] // Immutable snapshot
  attempts        ExamAttempt[]

  @@map("exams")
}

// Immutable snapshot of questions, marks, and answer keys at publish time
model ExamQuestion {
  id            String   @id @default(uuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  originalQuestionId String?
  orderIndex    Int      @default(0)
  type          String   // 'MCQ' | 'SHORT_ANSWER' | 'STRUCTURED'
  prompt        String
  options       Json?
  correctAnswer String   // Snapshot of answer key
  explanation   String   // Snapshot of explanation
  topicId       String
  marks         Float    @default(1.0)
  createdAt     DateTime @default(now())

  @@map("exam_questions")
}

model ExamAttempt {
  id             String          @id @default(uuid())
  examId         String?
  exam           Exam?           @relation(fields: [examId], references: [id], onDelete: SetNull)
  quizId         String?
  userId         String
  idempotencyKey String?         @unique
  status         AttemptStatus   @default(IN_PROGRESS)
  totalMarks     Float           @default(0.0)
  score          Float           @default(0.0)
  percentage     Float           @default(0.0)
  startedAt      DateTime        @default(now())
  submittedAt    DateTime?
  answers        StudentAnswer[]

  @@index([userId, status])
  @@map("exam_attempts")
}

model StudentAnswer {
  id            String      @id @default(uuid())
  attemptId     String
  attempt       ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String
  topicId       String
  studentAnswer String
  isCorrect     Boolean     @default(false)
  marksObtained Float       @default(0.0)
  maxMarks      Float       @default(1.0)
  feedback      String?
  createdAt     DateTime    @default(now())

  @@map("student_answers")
}

model Outbox {
  id            String    @id @default(uuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  published     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?

  @@index([published, createdAt])
  @@map("outbox")
}
