FROM node:22-alpine AS base
WORKDIR /app
RUN npm install -g pnpm@12.8.1

# Prune / prepare workspace files
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages/ ./packages/
COPY services/ ./services/

ARG SERVICE_NAME
ENV SERVICE_NAME=${SERVICE_NAME}

RUN pnpm install --frozen-lockfile=false

# Generate Prisma client if service has prisma schema
RUN if [ -f "services/${SERVICE_NAME}/prisma/schema.prisma" ]; then \
      cd "services/${SERVICE_NAME}" && npx prisma generate; \
    fi

RUN pnpm turbo run build --filter=@studypal/${SERVICE_NAME}...

EXPOSE 8000
CMD node services/${SERVICE_NAME}/dist/main.js
