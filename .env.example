# StudyPal Root Environment Variables

NODE_ENV=development
PORT=8000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000/api/v1

# Security & Tokens
JWT_ACCESS_SECRET=studypal_dev_access_token_secret_which_is_very_secure_32bytes
JWT_REFRESH_SECRET=studypal_dev_refresh_token_secret_which_is_very_secure_32bytes
INTERNAL_SERVICE_SECRET=studypal_dev_internal_service_hmac_secret_32bytes_min
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800

# Redis & Event Bus
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# S3 / MinIO Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=studypal-documents
S3_FORCE_PATH_STYLE=true

# Databases (Postgres port 5432)
DATABASE_URL_IDENTITY=postgresql://postgres:postgres@localhost:5432/studypal_identity?schema=public
DATABASE_URL_CONTENT=postgresql://postgres:postgres@localhost:5432/studypal_content?schema=public
DATABASE_URL_DOCUMENT=postgresql://postgres:postgres@localhost:5432/studypal_document?schema=public
DATABASE_URL_KNOWLEDGE=postgresql://postgres:postgres@localhost:5432/studypal_knowledge?schema=public
DATABASE_URL_ASSESSMENT=postgresql://postgres:postgres@localhost:5432/studypal_assessment?schema=public
DATABASE_URL_PROGRESS=postgresql://postgres:postgres@localhost:5432/studypal_progress?schema=public
DATABASE_URL_TUTOR=postgresql://postgres:postgres@localhost:5432/studypal_tutor?schema=public
DATABASE_URL_AI=postgresql://postgres:postgres@localhost:5432/studypal_ai?schema=public

# Inter-Service Internal HTTP URLs
IDENTITY_SERVICE_URL=http://localhost:8001
CONTENT_SERVICE_URL=http://localhost:8002
DOCUMENT_SERVICE_URL=http://localhost:8003
KNOWLEDGE_SERVICE_URL=http://localhost:8004
AI_SERVICE_URL=http://localhost:8005
ASSESSMENT_SERVICE_URL=http://localhost:8006
PROGRESS_SERVICE_URL=http://localhost:8007
TUTOR_SERVICE_URL=http://localhost:8008

# AI Service Configuration
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_DIMENSIONS=1536
AI_DAILY_TOKEN_QUOTA=100000

# Voice / Vapi
VAPI_API_KEY=vapi_mock_key_development
VAPI_ASSISTANT_ID=vapi_mock_assistant_id
VAPI_WEBHOOK_SECRET=vapi_mock_webhook_secret_key

# Observability
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
ENABLE_TRACING=false
